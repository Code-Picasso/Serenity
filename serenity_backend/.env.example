# ===== Shared =====
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# ===== API Gateway =====
GATEWAY_PORT=8000
AUTH_SERVICE_URL=http://auth-service:8001
CHAT_SERVICE_URL=http://chat-service:8002
FEED_SERVICE_URL=http://feed-service:8004
POST_SERVICE_URL=http://post-service:8005
USER_SERVICE_URL=http://user-service:8006
NOTIFICATION_SERVICE_URL=http://notification-service:8007
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# ===== Auth service (Node + Prisma) =====
AUTH_PORT=8001
AUTH_DATABASE_URL=postgresql://serenity:serenity@auth-db:5432/auth?schema=public

# ===== Chat service (Node + Prisma) =====
CHAT_PORT=8002
CHAT_DATABASE_URL=postgresql://serenity:serenity@chat-db:5432/chat?schema=public
CORS_ORIGIN=*

# ===== Feed service (Go + GORM) =====
FEED_PORT=8004
FEED_DATABASE_URL=postgresql://serenity:serenity@feed-db:5432/feed?sslmode=disable
GNEWS_API_KEY=
MEDIASTACK_API_KEY=
CURRENTS_API_KEY=
JOKE_API_URL=https://v2.jokeapi.dev/joke/Any
OFFICIAL_JOKE_API_URL=https://official-joke-api.appspot.com/random_joke
INGEST_INTERVAL_MINUTES=30
MOCK_MODE=true

# ===== Post service (Go + GORM) =====
POST_PORT=8005
POST_DATABASE_URL=postgresql://serenity:serenity@post-db:5432/post?sslmode=disable

# ===== User service (Go + GORM) =====
USER_PORT=8006
USER_DATABASE_URL=postgresql://serenity:serenity@user-db:5432/user?sslmode=disable

# ===== Notification service (Go + GORM) =====
NOTIFICATION_PORT=8007
NOTIFICATION_DATABASE_URL=postgresql://serenity:serenity@notification-db:5432/notification?sslmode=disable

# ===== PostgreSQL (one per stateful service) =====
POSTGRES_USER=serenity
POSTGRES_PASSWORD=serenity
